{{> layout/header}}<div class="container p-5">    <div class="card">        <div class="card-header"><b>글쓰기</b></div>        <div class="card-body">            {{! name 속성의 값이 서버에서 받을 때의 이름이 됩니다 }}            <form action="/board/save" method="post">                <div class="mb-3">                    <input type="text" class="form-control" placeholder="제목" name="title">                </div>                <div class="mb-3">                    <textarea class="form-control" rows="5" placeholder="내용" name="content"></textarea>                </div><!--                체크하면 premium=true, 체크안하면 아무값도 보체지 않음. 무료여부 처리-->                <div class="mb-3 form-check">                    {{! 수정 확인: Bootstrap 체크박스 클래스 오타 수정 }}
                    <input type="checkbox" class="form-check-input" id="premium"                            name="premium" value="true">                    <label for="premium" class="form-check-label">유료게시글로 등록(다른 사용자는 500포인트로 구매)</label>                </div>                <button class="btn btn-primary form-control">글쓰기 완료</button>            </form>        </div>    </div></div>{{> layout/footer}}