{{> layout/header}}<div class="container p-5">    {{! 수정, 삭제 버튼: 오른쪽 정렬 }}    {{#isOwner}}    <div class="d-flex justify-content-end">        <a href="/board/{{board.id}}/update" class="btn btn-warning me-1">수정</a>        {{! 수정 확인: 기존 POST 삭제 경로를 사용하며 전송 전에 확인한다. }}
        <form action="/board/{{board.id}}/delete" method="post" onsubmit="return confirm('정말 삭제하시겠습니까?')">            <button class="btn btn-danger">삭제</button>        </form>    </div>    {{/isOwner}}    <div class="d-flex justify-content-end">        <b>작성자</b> : {{board.username}}    </div>    <div>        <h2>            <b>{{board.title}}</b>            {{#board.premium}} <span class="badge bg-warning text-dark">유료</span> {{/board.premium}}        </h2>        <hr>        {{#board.canRead}}        <div class="m-4 p-2">            {{board.content}}        </div>        {{/board.canRead}}        {{! 유료 게시글을 못 보는 상태  }}        {{! 수정 확인: 안내 문구와 구매 버튼은 DTO의 가격을 사용한다. }}
        {{^board.canRead}}        <div>            <p>유료 게시글입니다. 구매 후 전체 내용을 볼수 있습니다 ({{board.price}} P)</p>            {{#sessionUser}}            {{! 로그인된 상태에서 포인트 차감을 통해 해당 게시글 구매 처리 해야 한다. (db 저장 해야 함)}}            <form action="/board/{{board.id}}/purchase" method="post"                  onsubmit="return confirm('{{board.price}} 포인트로 이 게시글을 열람하시겠습니까?')">                <button type="submit" class="btn btn-primary" >열람하기 {{board.price}} P</button>            </form>            {{/sessionUser}}            {{^sessionUser}}            {{! 로그인 안된 사람은 로그인 페이지로 이동 }}            <a href="/login" class="btn btn-outline-primary">로그인 후 구매</a>            {{/sessionUser}}        </div>        {{/board.canRead}}    </div>    <div class="card mt-3">        <div class="card-body">            <form action="/reply/save" method="post">                <input type="hidden" name="boardId" value="{{board.id}}">                <textarea class="form-control" rows="2" name="comment" placeholder="댓글을 입력하세요"></textarea>                <div class="d-flex justify-content-end">                    <button type="submit" class="btn btn-outline-primary mt-1">댓글 등록</button>                </div>            </form>        </div>        <div class="card-footer"><b>댓글 목록</b></div>        <div class="list-group">            {{#replyList}}            <div class="list-group-item d-flex justify-content-between align-items-center">                <div class="d-flex">                    <div class="px-1 me-1 bg-primary text-white rounded">{{username}}</div>                    <div>{{comment}}</div>                </div>                {{#isOwner}}                <form action="/reply/{{id}}/delete" method="post">                    <input type="hidden" name="boardId" value="{{board.id}}">                    <button class="btn"><i class="fa-solid fa-trash"></i></button>                </form>                {{/isOwner}}            </div>            {{/replyList}}        </div>    </div></div>{{! 수정 확인: 존재하지 않는 deleteForm 및 DELETE API를 참조하던 스크립트 제거. 위 POST 폼으로 삭제한다. }}{{> layout/footer}}