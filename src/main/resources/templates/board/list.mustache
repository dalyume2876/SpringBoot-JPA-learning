{{> layout/header}}<div class="container p-5">    <form action="/" method="get" class="d-flex mb-4">        <input type="text" class="form-control me-2" placeholder="제목 또는 내용으로 검색"        name="keyword" value="{{keyword}}">        <button type="submit" class="btn btn-secondary text-nowrap me-2">검색</button>        <a href="/" class="bth btn-secondary text-nowrap">초기화</a>    </form>    {{#isSearch}}        <p class="text-muted"><b>{{keyword}}</b> 검색결과 : {{boardPage.totalElements}} 건</p>    {{/isSearch}}    {{#boardPage.content}}    <div class="card mb-3">        <div class="card-body">            <h4 class="card-title">{{title}}</h4>            <p> 작성자 : {{username}} | 작성일 {{createdAt}}</p>            <a href="/board/{{id}}" class="btn btn-primary">상세보기</a>        </div>    </div>    {{/boardPage.content}}    {{^boardPage.content}}        <div class="text-center mt-5">            <h5>게시글이 없습니다.</h5>        </div>    {{/boardPage.content}}    <!--  페이지네이션 (추후 구현 예정)   -->    <ul class="pagination d-flex justify-content-center" >        {{#boardPage.hasPrevious}}            <li class="page-item">                <a class="page-link" href="?page={{boardPage.previousPage}}&size={{boardPage.size}}&keyword={{keywordParam}}">Previous</a>            </li>        {{/boardPage.hasPrevious}}        {{^boardPage.hasPrevious}}            <li class="page-item disabled"><a class="page-link">Previous</a></li>        {{/boardPage.hasPrevious}}        {{#boardPage.pageLinks}}            <li class="page-item">                <a class="page-link {{#active}}active{{/active}}" href="?page={{number}}&size={{boardPage.size}}&keyword={{keywordParam}}">{{number}}</a>            </li>        {{/boardPage.pageLinks}}        {{#boardPage.hasNext}}        <li class="page-item"><a class="page-link" href="?page={{boardPage.nextPage}}&size={{boardPage.size}}&keyword={{keywordParam}}" >Next</a></li>        {{/boardPage.hasNext}}        {{^boardPage.hasNext}}        <li class="page-item disabled"><a class="page-link">Next</a></li>        {{/boardPage.hasNext}}    </ul></div>{{> layout/footer}}