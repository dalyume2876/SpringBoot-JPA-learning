{{> layout/header}}<div class="container p-5">    <div class="card">        <div class="card-header"><h4 class="mb-0"><b>포인트 충전</b></h4></div>        <div class="card-body">            <label class="form-label fw-bold">현재 보유 포인트</label>            <div class="mb-4">                <span class="badge bg-primary fs-5"> P</span>            </div>            <hr>            <div class="mb-4">                <label class="form-label fw-bold mb-3">충전할 포인트 선택</label>                <!--  이벤트 위임 방식으로 수정 -->                <div class="row g-3" id="point-btn-group">                    <div class="col-md-4">                        <button type="button" class="btn btn-outline-primary w-100 point-btn" data-amount="1000">1,000                            P                        </button>                    </div>                    <div class="col-md-4">                        <button type="button" class="btn btn-outline-primary w-100 point-btn" data-amount="5000">5,000                            P                        </button>                    </div>                    <div class="col-md-4">                        <button type="button" class="btn btn-outline-primary w-100 point-btn" data-amount="10000">10,000                            P                        </button>                    </div>                    <div class="col-md-4">                        <button type="button" class="btn btn-outline-primary w-100 point-btn" data-amount="20000">20,000                            P                        </button>                    </div>                    <div class="col-md-4">                        <button type="button" class="btn btn-outline-primary w-100 point-btn" data-amount="50000">50,000                            P                        </button>                    </div>                    <div class="col-md-4">                        <button type="button" class="btn btn-outline-primary w-100 point-btn" data-amount="100000">                            100,000 P                        </button>                    </div>                </div>            </div>            <div class="mb-4">                <label class="form-label fw-bold">충전 예정 금액</label>                <p class="form-control-plaintext">                    <span class="badge bg-success fs-5" id="selected-amount">0</span> P                </p>            </div>            <div class="d-grid gap-2">                <button type="button" class="btn btn-primary" id="charge-btn" disabled>충전하기</button>                <a href="/user/detail" class="btn btn-secondary">취소</a>            </div>        </div>    </div></div><script src="https://cdn.portone.io/v2/browser-sdk.js"></script><script>    let selectedAmount = 0;    const pointBtns = document.querySelectorAll(".point-btn");    const amountDisplay = document.querySelector("#selected-amount");    const chargeBtn = document.querySelector("#charge-btn");    document.querySelector("#point-btn-group").addEventListener("click", function(event) {        // 클릭한 곳에서 가장 가까운 .point-btn 찾기        const btn = event.target.closest(".point-btn")        pointBtns.forEach(b => b.classList.remove("active"));        btn.classList.add("active");        selectedAmount = Number(btn.dataset.amount);        amountDisplay.innerText = selectedAmount.toLocaleString();        chargeBtn.disabled = false;    });    chargeBtn.addEventListener("click", async function() {        if (selectedAmount <= 0) {            return;        }        chargeBtn.disabled = true; //중복클릭 방지        try {            // 1 단계 - 우리 서버에 결제 건 생성 요청 (paymentIt, storeid, channelKey 받기)            const prepareRes = await fetch("/api/payment/prepare", {                method: "POST",                headers: {"Content-Type" : "application/json"},                body: JSON.stringify({amount: selectedAmount})            });            const prepare = await prepareRes.json(); // JSON => JS Object            if (!prepareRes.ok) {                alert("잘못된 요청입니다.")            }            // 2단계 포트원 결제창 호출            const paymentRes = await PortOne.requestPayment({                  // Store ID 설정                storeId: prepare.storeId,                      // 채널 키 설정                channelKey: prepare.channelKey,                paymentId: prepare.paymentId,                orderName: "포인트 충전",                totalAmount: prepare.amount,                currency: "CURRENCY_KRW",                payMethod: "EASY_PAY",            });            console.log(paymentRes);            if (!paymentRes || paymentRes.code !== undefined) {                alert("결제가 완료되지 않았습니다.");            }            // 3단계 서버 검증 요청 (우리서버에서 포트원 서버로 직접 HTTP 통신 후 정상적인 부분 확인 후 포인트 충전)            const completeRes = await fetch("/api/payment/complete", {                method: "POST",                headers: {"Content-Type" : "application/json"},                body: JSON.stringify({paymentId: paymentRes.paymentId})            });            const result = await completeRes.json();            if (!completeRes.ok) {                alert("포인트 충전에 실패했습니다");            }            alert("충전이 완료 되었습니다. \n충전금액 : " + result.amount.toLocaleString() + "\n 현재 보유포인트 : " + result.currentPoint);            location.href = "/user/detail";        } catch (error) {            alert(error.message);        }    });</script>{{> layout/footer}}