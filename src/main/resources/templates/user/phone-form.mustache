{{> layout/header}}<div class="container p-5">    <div class="card">        <div class="card-header">            <b>휴대전화 인증</b>        </div>        <div class="card-body">            <!-- 등록된 전화번호 -->            <div class="mb-3">                <label class="form-label">전화번호</label>                <div class="input-group">                    <input type="tel"                           class="form-control"                           value="{{phoneNumber}}"                           readonly>                    <button type="button"                            class="btn btn-outline-secondary"                            onclick="sendCode()">                        인증번호 발송                    </button>                </div>            </div>            <!-- 인증번호 입력 -->            <div class="mb-3" id="code-box">                <div class="input-group">                    <input type="text"                           class="form-control"                           id="code"                           placeholder="인증번호 6자리"                           maxlength="6"                           inputmode="numeric">                    <button type="button"                            class="btn btn-outline-secondary"                            onclick="verifyCode()">                        확인                    </button>                </div>                <div id="msg" class="form-text"></div>            </div>            <a href="/user/update"               class="btn btn-secondary">                마이페이지로 돌아가기            </a>        </div>    </div></div><script>    /**     * SMS 인증번호 발송     */    async function sendCode() {        try {            const response = await fetch("/api/sms/send", {                method: "POST"            });            const data = await response.json();            if (!response.ok) {                throw new Error(data.message || "인증번호 발송 실패");            }            alert(data.message);        } catch (error) {            alert(error.message);        }    }    /**     * SMS 인증번호 검증     */    async function verifyCode() {        const code = document.getElementById("code").value.trim();        const msg = document.getElementById("msg");        if (!/^\d{6}$/.test(code)) {            msg.textContent = "인증번호 6자리를 입력해주세요.";            msg.style.color = "red";            return;        }        try {            const response = await fetch("/api/sms/verify", {                method: "POST",                headers: {                    "Content-Type": "application/json"                },                body: JSON.stringify({ code })            });            const data = await response.json();            if (!response.ok) {                throw new Error(data.message || "인증에 실패했습니다.");            }            msg.textContent = "휴대전화 인증이 완료되었습니다.";            msg.style.color = "green";            alert(data.message);            window.location.href = "/user/detail";        } catch (error) {            msg.textContent = error.message;            msg.style.color = "red";        }    }</script>{{> layout/footer}}