{{> layout/header}}<div class="container p-5">    <div class="card">        <div class="card-header"><b>마이페이지</b></div>        <div class="card-body">            <div class="text-center mb-4">                {{#user.profileImage}}                <img src="{{user.profileImage}}" alt="" class="rounded-circle border"                     style="width: 200px; height: 200px; object-fit: cover">                {{/user.profileImage}}                {{^user.profileImage}}                <div class="rounded-circle border bg-secondary d-inline-flex align-items-center justify-content-center"                     style="width: 200px; height: 200px">                    <span>프로필 사진 없음</span>                </div>                {{/user.profileImage}}            </div>            <div class="mb-3">                <label class="form-label fw-bold">사용자명</label>                <p class="form-control-plaintext">{{user.username}}</p>            </div>            <div class="mb-3">                <label class="form-label fw-bold">이메일</label>                <p class="form-control-plaintext">{{user.email}}</p>            </div>            <div class="mb-3">                <label class="form-label fw-bold">전화번호</label>                <p class="form-control-plaintext">                    {{#user.phoneVerified}}                <p style="color: green;">인증됨</p>                {{/user.phoneVerified}}                {{^user.phoneVerified}}                <p style="color: red;">인증되지 않음</p>                {{/user.phoneVerified}}                </p>            </div>            <div class="mb-3">                <label class="form-label fw-bold">가입일</label>                <p class="form-control-plaintext">{{user.createdAt}}</p>            </div>            <!--            보유포인트 + 충전 (임시 추후 삭제) 결제와 연동-->            <div class="mb-3">                <label class="form-label fw-bold">보유 포인트</label>                <p class="form-control-plaintext">                    <span id="point-display">{{user.point}} <b>P</b></span>                </p>                <div class="input-group" style="max-width: 320px;">                    <input type="number" id="charge-amount" class="form-control"                           placeholder="충전할 포인트" value="1000" min="1">                    <button type="button" class="btn btn-outline-success" onclick="chargePoint()">포인트 충전</button>                </div>            </div>            <div class="mb-3">                <a href="/user/update" class="btn btn-primary">회원 정보 수정</a>                {{^user.phoneVerified}}                <a href="/user/phone" class="btn btn-secondary">전화번호 인증</a>                {{/user.phoneVerified}}                <a href="/" class="btn btn-secondary">목록으로</a>            </div>        </div>    </div></div><script>    async function chargePoint() {        const amount = Number(document.querySelector("#charge-amount").value);        if (!amount || amount <= 0) {            alert("충전할 포인트를 올바르게 입력하세요.");            return;        }        try {            const response = await fetch("/api/point/charge", {                method: "POST",                headers: {"Content-Type" : "application/json"},                body: JSON.stringify({amount: amount})            });            const result = await response.json();            if (response.ok) {                document.querySelector("#point-display").innerHTML = result.point + " <b> P</b>";            }            alert(result.message);        } catch (error) {            alert("서버와 통신하지못했습니다.");        }    }</script>{{> layout/footer}}