<!DOCTYPE html><html lang="ko"><head>    <meta charset="utf-8">    <meta name="viewport" content="width=device-width, initial-scale=1">    <title>Blog</title>    <link rel="icon" href="data:;base64,iVBORw0KGgo=">    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet"></head><body class="d-flex flex-column min-vh-100"><nav class="navbar navbar-expand-sm bg-dark navbar-dark">    <div class="container-fluid">        <a class="navbar-brand" href="/">Tencoding</a>        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">            <span class="navbar-toggler-icon"></span>        </button>        <div class="collapse navbar-collapse" id="collapsibleNavbar">            <ul class="navbar-nav">                {{#sessionUser}}                <!--  로그인 했을 때 보여져야 하는 메뉴 -->                <li class="nav-item"><a class="nav-link" href="/board/save">글쓰기</a></li>                <li class="nav-item"><a class="nav-link" href="/user/detail">마이페이지</a></li>                <li class="nav-item"><a class="nav-link" href="/logout">로그아웃</a></li>                {{#admin}}                <!-- 관리자에게만 보이는 메뉴  -->                <li class="nav-item"><a class="nav-link" href="/admin/dashboard">관리자</a></li>                {{/admin}}                {{/sessionUser}}                {{^sessionUser}}                <!--  로그인 안 했을 때 보여져야 하는 메뉴  -->                <li class="nav-item"><a class="nav-link" href="/join">회원가입</a></li>                <li class="nav-item"><a class="nav-link" href="/login">로그인</a></li>                {{/sessionUser}}            </ul>            {{! 오른쪽 : 역할 배지와 사용자명 }}            <ul class="navbar-nav ms-auto">                {{#sessionUser}}                <li class="nav-item d-flex align-items-center">                    <span class="badge bg-secondary me-2">{{roleDisplay}}</span>                    <span class="text-light">{{username}} 님</span>                </li>                {{/sessionUser}}            </ul>        </div>    </div></nav>